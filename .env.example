# GCare HMS local development settings — PLACEHOLDERS ONLY.
# Copy to .env and fill locally. Never commit .env or real credentials.
# Development, demo and test environments use synthetic data only.

# --- PostgreSQL (local development) ---
# Throwaway local-only values used by docker-compose.yml and the backend's local defaults.
# Use generated secrets in every shared environment.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gcare_hms_dev
DB_USERNAME=gcare
DB_PASSWORD=gcare

# --- Backend ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Identity provider: Keycloak (OD-03, ADR-012) ---
# The local profile defaults to the Compose Keycloak (http://localhost:8180/realms/gcare) and its
# throwaway client secret. Every other environment must set these; the backend will not start without them.
# AUTH_ISSUER_URI=https://<keycloak-host>/realms/<realm>
# AUTH_CLIENT_ID=gcare-hms-backend
# AUTH_CLIENT_SECRET=<from the secret store, never committed>
# AUTH_POST_LOGIN_REDIRECT=https://<gcare-host>/
# AUTH_POST_LOGOUT_REDIRECT=https://<gcare-host>/
# Local Keycloak admin console (http://localhost:8180). Throwaway local-only values.
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Sessions ---
# Placeholders until the security owner approves session policy. Cookies are Secure (HTTPS-only)
# outside the local profile.
# SESSION_IDLE_TIMEOUT=30m
# SESSION_MAX_LIFETIME=12h

# --- OpenAPI document (/v3/api-docs, signed-in users only). On in the local profile. ---
# OPENAPI_ENABLED=false

# --- Management port: health details and metrics (docs/23). Never publish it through the proxy. ---
# MANAGEMENT_PORT=8081
# MANAGEMENT_ADDRESS=127.0.0.1

# --- Backups (infra/backup, docs/23). No defaults: set from the approved RPO and retention. ---
# BACKUP_DIR=
# BACKUP_GPG_RECIPIENT=
# BACKUP_RETENTION_DAYS=
# BACKUP_METRICS_FILE=
# BACKUP_MAX_AGE_SECONDS=

# --- DICOM archive / viewer ---
# Not used until Phase 6 (OD-14). Never place archive credentials in the frontend.
# DICOM_ARCHIVE_BASE_URL=
